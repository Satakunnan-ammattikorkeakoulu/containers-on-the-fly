meta {
  name: Get All Reservations for Calendar
  type: http
  seq: 7
}

get {
  url: {{root_url}}/reservation/get_all_reservations_for_calendar?startDate=2030-02-01T00:00:00&endDate=2030-02-28T00:00:00
  body: none
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response is successful", function() {
    expect(res.body).to.have.property('status');
    expect(res.body.status).to.equal(true);
  });

  test("Response has data", function() {
    expect(res.body).to.have.property('data');
  });
}
