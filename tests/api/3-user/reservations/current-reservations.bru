meta {
  name: Get Current Reservations
  type: http
  seq: 4
}

get {
  url: {{root_url}}/reservation/get_current_reservations
  body: none
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response is successful", function() {
    expect(res.body).to.have.property('status');
    expect(res.body.status).to.equal(true);
  });

  test("Response has reservations array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.have.property('reservations');
    expect(res.body.data.reservations).to.be.an('array');
  });
}
