meta {
  name: Extend Reservation
  type: http
  seq: 9
}

post {
  url: {{root_url}}/reservation/extend_reservation?reservationId=1&duration=2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response has status field", function() {
    expect(res.body).to.have.property('status');
  });

  test("Response has message", function() {
    expect(res.body).to.have.property('message');
  });
}
