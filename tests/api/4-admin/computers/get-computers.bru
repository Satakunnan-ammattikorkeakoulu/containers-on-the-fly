meta {
  name: Get All Computers
  type: http
  seq: 1
}

get {
  url: {{root_url}}/admin/computers
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response is successful", function() {
    expect(res.body).to.have.property('status');
    expect(res.body.status).to.equal(true);
  });

  test("Response has computers array", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.have.property('computers');
    expect(res.body.data.computers).to.be.an('array');
  });

  test("Computer items have required fields", function() {
    if (res.body.data.computers.length > 0) {
      const computer = res.body.data.computers[0];
      expect(computer).to.have.property('computerId');
      expect(computer).to.have.property('name');
      expect(computer).to.have.property('ip');
      expect(computer).to.have.property('public');
      expect(computer).to.have.property('hardwareSpecs');
      expect(computer.hardwareSpecs).to.be.an('array');
    }
  });
}
