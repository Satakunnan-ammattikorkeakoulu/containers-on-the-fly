meta {
  name: Save Role Mounts
  type: http
  seq: 5
}

post {
  url: {{root_url}}/admin/save_role_mounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "roleId": 1,
    "mounts": []
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response has status field", function() {
    expect(res.body).to.have.property('status');
  });
}
