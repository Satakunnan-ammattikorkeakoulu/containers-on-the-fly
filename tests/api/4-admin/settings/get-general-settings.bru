meta {
  name: Get General Settings
  type: http
  seq: 1
}

get {
  url: {{root_url}}/admin/general-settings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response is successful", function() {
    expect(res.body).to.have.property('status');
    expect(res.body.status).to.equal(true);
  });

  test("Response has settings data", function() {
    expect(res.body).to.have.property('data');
    const data = res.body.data;
    expect(data).to.have.property('general');
    expect(data).to.have.property('access');
    expect(data).to.have.property('email');
    expect(data).to.have.property('auth');
  });

  test("General settings have required fields", function() {
    const general = res.body.data.general;
    expect(general).to.have.property('applicationName');
    expect(general).to.have.property('timezone');
  });

  test("Email settings have required fields", function() {
    const email = res.body.data.email;
    expect(email).to.have.property('smtpServer');
    expect(email).to.have.property('smtpPort');
    expect(email).to.have.property('smtpUsername');
    expect(email).to.have.property('fromEmail');
  });
}
